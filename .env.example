# Copia este fichero a .env y rellena los valores.
# En Vercel estas mismas variables se definen en Settings -> Environment Variables.
# Nunca se versiona un .env con valores reales.

# Cadena de conexion de Postgres.
# Con Neon: Dashboard -> Connection string -> "Pooled connection".
DATABASE_URL="postgresql://usuario:contrasena@ep-xxx.eu-central-1.aws.neon.tech/infochange?sslmode=require"

# Clave para firmar los tokens de sesion. Minimo 32 caracteres.
# Generala con:  node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Solo si el frontend se sirve desde otro dominio distinto al de la API.
# En el despliegue normal de Vercel comparten origen y esto se deja vacio.
# CORS_ORIGIN="https://infochange.vercel.app"

# Solo para `npm run db:seed`, al crear la cuenta de administrador.
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""
