{
  "name": "infochange",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador de exchange de criptomonedas: React + Hono + Postgres, desplegado como un unico proyecto en Vercel.",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace server",
    "build": "npm run build --workspace web",
    "lint": "npm-run-all lint:web lint:server",
    "lint:web": "npm run lint --workspace web",
    "lint:server": "npm run lint --workspace server",
    "typecheck": "npm-run-all typecheck:web typecheck:server",
    "typecheck:web": "npm run typecheck --workspace web",
    "typecheck:server": "npm run typecheck --workspace server",
    "test": "npm run test --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "verify": "npm-run-all typecheck lint test build check:bundle",
    "check:bundle": "node scripts/check-vercel-bundle.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.6.14"
  },
  "overrides": {
    "jspdf": "^4.2.1",
    "tar": "^7.4.3",
    "brace-expansion": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.7.2"
  }
}
